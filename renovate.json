{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    ":semanticCommitTypeAll(chore)",
    "schedule:daily",
    "group:all"
  ],
  "forkProcessing": "enabled",
  "configMigration": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?( registryUrl=(?<registryUrl>.*?))?\\s.*?_VERSION\\s?:?=\\s?(?<currentValue>.*)\\s"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
      "description": [
        "Custom dependency manager for updating tools defined in Makefiles."
      ]
    }
  ],
  "enabled": true,
  "enabledManagers": [
    "custom.regex",
    "dockerfile",
    "github-actions",
    "gomod"
  ],
  "labels": [
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "k8s.io/client-go"
      ],
      "allowedVersions": "/^v[0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+)?$/"
    },
    {
      "description": "Pin cosign-installer",
      "matchPackageNames": [
        "sigstore/cosign-installer"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "minimumReleaseAge": "60 days",
      "matchPackageNames": [
        "k8s.io{/,}**"
      ]
    },
    {
      "description": [
        "Keep the go.mod toolchain directive current; Renovate leaves it alone by default.",
        "It selects the toolchain CI installs, since the workflows use go-version-file: go.mod."
      ],
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "matchDepNames": [
        "go"
      ],
      "rangeStrategy": "bump"
    },
    {
      "matchFileNames": [
        "Makefile"
      ],
      "extractVersion": "^v(?<version>.*)$",
      "description": [
        "Add build label to PRs which are related to build tools defined in Makefiles.",
        "Group Makefile dependency updates in single PR."
      ]
    }
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "rebaseWhen": "behind-base-branch",
  "semanticCommits": "enabled",
  "timezone": "Etc/UTC"
}
